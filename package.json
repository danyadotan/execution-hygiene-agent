{
  "name": "execution-hygiene-agent",
  "version": "0.1.0",
  "description": "A reusable reduction layer between verified agent output and human attention.",
  "type": "module",
  "license": "MIT",
  "author": "Danya Dotan",
  "homepage": "https://tab-at-work.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/danyadotan/execution-hygiene-agent.git"
  },
  "bugs": {
    "url": "https://github.com/danyadotan/execution-hygiene-agent/issues"
  },
  "keywords": [
    "ai-agents",
    "agentic-workflows",
    "human-in-the-loop",
    "execution-reliability",
    "human-attention",
    "governance",
    "approval-boundaries"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/hygiene.js",
  "types": "./dist/hygiene.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hygiene.d.ts",
      "import": "./dist/hygiene.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "demo": "tsx src/index.ts",
    "test": "tsx --test tests/hygiene.test.ts",
    "check": "npm run build && npm run demo && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
